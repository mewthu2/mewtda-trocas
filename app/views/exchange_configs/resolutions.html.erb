<% content_for :title, "Aprovação, cupom e devolução" %>
<% c = @exchange_config %>

<%= render "tabs" %>

<%= form_with model: c, url: exchange_config_path, method: :patch, scope: :exchange_config, html: { autocomplete: "off" } do |f| %>
  <div class="grid grid--detail">
    <div class="stack">
      <section class="card">
        <h2 class="title-medium card__title"><%= icon "verified" %> Aprovação</h2>
        <%= m3_switch f, :auto_approve, "Aprovação automática para casos simples",
                      "Aprova na hora quando o motivo não exige análise, não há foto, o valor está no limite e não há suspeita de abuso." %>
        <div class="field-row">
          <%= m3_field f, :auto_approve_max_value, "Valor máximo para aprovar sozinho (R$)", as: :number_field, step: "0.01", min: 0,
                       hint: "Vazio = sem limite." %>
          <%= m3_select f, :resolve_on, "Gerar cupom / registrar devolução", ExchangeConfig::RESOLVE_ON.invert.to_a %>
        </div>
        <div class="field-row">
          <%= m3_field f, :abuse_max_requests, "Alerta de abuso a partir de", as: :number_field, min: 1 %>
          <%= m3_field f, :abuse_window_days, "solicitações em (dias)", as: :number_field, min: 1 %>
        </div>
      </section>
    </div>

    <div class="stack">
      <section class="card">
        <h2 class="title-medium card__title"><%= icon "redeem" %> Cupom</h2>
        <p class="body-small muted">Gerado na Shopify, de uso único, no valor dos itens em que o cliente escolheu cupom.</p>
        <%= m3_field f, :coupon_validity_days, "Validade (dias)", as: :number_field, min: 1 %>
        <%= m3_switch f, :credit_link_customer, "Vincular ao cliente", "Só o cliente da solicitação consegue usar." %>
        <%= m3_switch f, :coupon_combines_with_discounts, "Acumular com outros descontos" %>
      </section>

      <section class="card">
        <h2 class="title-medium card__title"><%= icon "currency_exchange" %> Devolução do dinheiro</h2>
        <p class="body-small muted">
          A equipe faz a devolução fora da plataforma e registra na solicitação. Em Pix e transferência, o cliente informa
          os dados bancários e a equipe anexa o comprovante, que fica visível para ele.
        </p>
        <div class="title-small">Formas oferecidas ao cliente</div>
        <%= m3_checkbox_group f, :refund_methods, ExchangeConfig::REFUND_METHODS %>
        <%= m3_field f, :refund_sla_days, "Prazo prometido para devolver (dias úteis)", as: :number_field, min: 0 %>
      </section>
    </div>
  </div>

  <%= render "save", section: "resolutions" %>
<% end %>
