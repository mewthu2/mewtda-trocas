<% accent = config.accent_color.presence || "#1b873f" %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head><meta charset="utf-8"><title><%= subject %></title></head>
  <body style="margin:0;padding:0;background:#f3f6f4;font-family:Roboto,Arial,sans-serif;color:#1a1c1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f6f4;padding:32px 12px;">
      <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;">
          <tr><td style="height:6px;background:<%= accent %>;"></td></tr>
          <% if logo_url %>
            <tr><td align="center" style="padding:28px 32px 0;"><img src="<%= logo_url %>" alt="<%= config.company_name %>" style="max-height:48px;max-width:200px;"></td></tr>
          <% end %>
          <% if image_url %>
            <tr><td style="padding:24px 32px 0;"><img src="<%= image_url %>" alt="" style="width:100%;border-radius:12px;display:block;"></td></tr>
          <% end %>
          <tr><td style="padding:28px 32px 8px;"><h1 style="margin:0;font-size:22px;line-height:1.3;font-weight:500;"><%= subject %></h1></td></tr>
          <tr><td style="padding:8px 32px 32px;font-size:15px;line-height:1.6;color:#404943;"><%= simple_format(body) %></td></tr>
          <tr><td style="padding:16px 32px;background:#f7faf8;font-size:12px;color:#707972;"><%= config.company_name %></td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
