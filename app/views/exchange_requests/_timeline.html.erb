<%
  er = exchange_request
  steps = if er.rejected?
    [ [ "Recebida", "inbox", :done ], [ "Não aprovada", "block", :error ] ]
  else
    reached = { "pending" => 1, "approved" => 2, "received" => 4, "completed" => 5 }.fetch(er.status)
    [ [ "Solicitada", "inbox" ], [ "Aprovada", "thumb_up" ], [ "Produto enviado", "local_shipping" ],
      [ "Recebido", "inventory" ], [ "Concluída", "task_alt" ] ].each_with_index.map do |(label, ic), i|
      state = if i < reached then :done
      elsif i == reached then :current
      else :todo
      end
      state = :done if i == 2 && reached >= 2 && (er.return_authorization_code.present? || er.return_tracking_code.present? || reached > 2)
      [ label, ic, state ]
    end
  end
%>
<ol class="stepper">
  <% steps.each do |label, ic, state| %>
    <li class="stepper__step stepper__step--<%= state %>">
      <span class="stepper__dot"><%= icon(state == :done ? "check" : ic) %></span>
      <span class="stepper__label"><%= label %></span>
    </li>
  <% end %>
</ol>
