<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= [ content_for(:title), "Quero Trocar" ].compact.join(" · ") %></title>
    <%= render "layouts/partials/head" %>
  </head>

  <body class="app">
    <header class="top-app-bar">
      <%= link_to authenticated_root_path, class: "brand" do %>
        <%= render "shared/brand" %>
      <% end %>

      <div class="top-app-bar__actions">
        <% if selectable_clients.any? %>
          <%= form_with url: current_client_path, method: :patch, class: "client-switcher", data: { controller: "auto-submit" } do %>
            <span class="msr">storefront</span>
            <%= select_tag :client_id, options_from_collection_for_select(selectable_clients, :id, :name, current_client&.id),
                           prompt: "Selecione a loja", data: { action: "change->auto-submit#submit" }, aria: { label: "Loja" } %>
          <% end %>
        <% elsif current_client %>
          <span class="assist-chip"><span class="msr">storefront</span><%= current_client.name %></span>
        <% end %>

        <details class="menu" data-controller="dismissable">
          <summary class="avatar" title="<%= current_user.display_name %>"><%= current_user.display_name.first.upcase %></summary>
          <div class="menu__surface">
            <div class="menu__header">
              <strong><%= current_user.display_name %></strong>
              <span><%= current_user.email %></span>
            </div>
            <%= button_to destroy_user_session_path, method: :delete, class: "menu__item", data: { turbo: false } do %>
              <span class="msr">logout</span> Sair
            <% end %>
          </div>
        </details>
      </div>
    </header>

    <nav class="nav-rail" aria-label="Navegação principal">
      <%= nav_item "Solicitações", "inbox", exchange_requests_path, active: controller_name == "exchange_requests" %>
      <%= nav_item "Configuração", "tune", edit_exchange_config_path, active: controller_name.in?(%w[exchange_configs email_domains]) %>
      <%= nav_item "Como usar", "help", help_path, active: controller_name == "help" %>
    </nav>

    <main class="main">
      <%= yield %>
      <%= render "shared/support_footer" %>
    </main>

    <%= render "shared/snackbar" %>
  </body>
</html>
