<ol class="stepper stepper--compact" aria-label="Etapas">
  <% [ "Pedido", "Itens", "Pronto" ].each_with_index do |label, i| %>
    <% state = i < current ? :done : (i == current ? :current : :todo) %>
    <li class="stepper__step stepper__step--<%= state %>">
      <span class="stepper__dot"><%= state == :done ? icon("check") : i + 1 %></span>
      <span class="stepper__label"><%= label %></span>
    </li>
  <% end %>
</ol>
