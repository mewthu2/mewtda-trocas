<% content_for :title, "Pedido #{@order[:number]}" %>

<div class="public-card public-card--wide">
  <%= render "header" %>
  <%= render "steps", current: 1 %>

  <div class="order-heading">
    <div>
      <div class="overline">Pedido</div>
      <h1 class="headline-small"><%= @order[:number] %></h1>
    </div>
    <%= link_to public_exchange_path(@config.slug), class: "btn btn--text" do %><%= icon "arrow_back" %> Outro pedido<% end %>
  </div>

  <% case @policy.status
     when :not_fulfilled %>
    <div class="banner banner--info"><%= icon "local_shipping" %><div>Esse pedido ainda não foi enviado. Assim que ele sair para entrega você poderá solicitar troca ou devolução aqui.</div></div>
  <% when :cancelled %>
    <div class="banner banner--error"><%= icon "cancel" %><div>Esse pedido foi cancelado e não pode ter troca ou devolução.</div></div>
  <% when :expired %>
    <div class="banner banner--warning"><%= icon "schedule" %><div>Os prazos de troca e devolução deste pedido já terminaram (ou todos os itens já foram solicitados). Se o produto tem defeito, fale com a loja.</div></div>
  <% else %>
    <%= form_with url: public_exchange_path(@config.slug), method: :post, multipart: true, class: "stack" do %>
      <%= hidden_field_tag :order_number, @order_number %>
      <%= hidden_field_tag :email, @email %>

      <p class="title-small">Quais itens você quer trocar ou devolver?</p>

      <% @policy.items.each do |options| %>
        <%= render "item", options: options, sent: (params.dig(:items, options.index.to_s) || {}) %>
      <% end %>

      <div class="field-row">
        <div class="text-field">
          <%= text_field_tag :customer_name, @customer_name, placeholder: " ", autocomplete: "name", required: true %>
          <label for="customer_name">Seu nome</label>
        </div>
        <div class="text-field">
          <%= telephone_field_tag :customer_phone, params[:customer_phone] || @order[:phone], placeholder: " ", autocomplete: "tel" %>
          <label for="customer_phone">Celular (WhatsApp)</label>
        </div>
      </div>

      <% if @config.return_modes.size > 1 || @config.return_modes != [ "loja" ] %>
        <fieldset class="stack stack--tight">
          <legend class="title-small">Como você prefere enviar o produto?</legend>
          <div class="choice-list">
            <% @config.return_modes.each_with_index do |mode, i| %>
              <label class="choice">
                <%= radio_button_tag :return_mode, mode, (params[:return_mode] || @config.return_modes.first) == mode %>
                <span><%= ExchangeConfig::RETURN_MODES[mode] %></span>
              </label>
            <% end %>
          </div>
          <% if @config.return_modes.include?("loja") && @config.store_drop_off_addresses.present? %>
            <div class="body-small muted"><strong>Lojas:</strong> <%= simple_format(@config.store_drop_off_addresses, {}, wrapper_tag: "span") %></div>
          <% end %>
          <div class="text-field">
            <%= text_field_tag :customer_zip, params[:customer_zip] || @order[:zip], placeholder: " ", inputmode: "numeric", autocomplete: "postal-code" %>
            <label for="customer_zip">CEP de onde o produto sai</label>
          </div>
        </fieldset>
      <% end %>

      <details class="disclosure">
        <summary class="title-small"><%= icon "pix" %> Pagou com Pix ou boleto?</summary>
        <div class="text-field">
          <%= text_field_tag :pix_key, params[:pix_key], placeholder: " " %>
          <label for="pix_key">Chave Pix para reembolso (se houver)</label>
          <span class="text-field__supporting">Só é usada se você escolher reembolso.</span>
        </div>
      </details>

      <p class="body-small muted">
        Analisamos em até <%= pluralize(@config.analysis_sla_days, "dia útil", plural: "dias úteis") %>.
        Reembolsos são feitos em até <%= pluralize(@config.refund_sla_days, "dia útil", plural: "dias úteis") %> após a conferência.
      </p>

      <%= button_tag type: "submit", class: "btn btn--filled btn--accent btn--block", data: { turbo_submits_with: "Enviando…" } do %>
        <%= icon "send" %> Enviar solicitação
      <% end %>
    <% end %>
  <% end %>
</div>
