<% content_for :title, "Pedido #{@order[:number]}" %>

<div class="public-card public-card--wide">
  <%= render "header" %>
  <%= render "steps", current: 1 %>

  <div class="order-heading">
    <div>
      <div class="overline">Pedido</div>
      <h1 class="headline-small"><%= @order[:number] %></h1>
    </div>
    <%= link_to public_exchange_path(@config.slug), class: "btn btn--text" do %><%= icon "arrow_back" %> Outro pedido<% end %>
  </div>

  <% case @eligibility
     when :not_fulfilled %>
    <div class="banner banner--info"><%= icon "local_shipping" %><div>Esse pedido ainda não foi enviado. Assim que ele sair para entrega você poderá solicitar troca ou devolução aqui.</div></div>
  <% when :cancelled %>
    <div class="banner banner--error"><%= icon "cancel" %><div>Esse pedido foi cancelado e não pode ter troca ou devolução.</div></div>
  <% else %>
    <% if @eligibility == :exchange_only %>
      <div class="banner banner--warning"><%= icon "schedule" %><div>O prazo de <%= @config.return_window_days %> dias para devolução já passou — ainda dá para pedir <strong>troca</strong>.</div></div>
    <% end %>

    <%= form_with url: public_exchange_path(@config.slug), method: :post, multipart: true, class: "stack" do %>
      <%= hidden_field_tag :order_number, @order_number %>
      <%= hidden_field_tag :email, @email %>

      <p class="title-small">Quais itens você quer trocar ou devolver?</p>

      <% @order[:items].each_with_index do |item, index| %>
        <% sent = params.dig(:items, index.to_s) || {} %>
        <fieldset class="pick-item" data-controller="pick-item" data-pick-item-defect-value="<%= ExchangeRequestItem::DEFECT_REASON %>">
          <%= hidden_field_tag "items[#{index}][index]", index %>
          <label class="pick-item__head">
            <%= check_box_tag "items[#{index}][selected]", "1", sent["selected"] == "1",
                              data: { pick_item_target: "toggle", action: "pick-item#toggle" }, id: "item_#{index}_selected" %>
            <span class="pick-item__check"><%= icon "check" %></span>
            <span class="pick-item__info">
              <span class="title-small"><%= item[:product_name] %></span>
              <span class="body-small muted"><%= [ item[:variant_title].presence, "Qtd. #{item[:quantity]}", brl(item[:price]) ].compact.join(" · ") %></span>
            </span>
          </label>

          <div class="pick-item__options" data-pick-item-target="options" <%= "hidden" unless sent["selected"] == "1" %>>
            <div class="segmented" role="radiogroup" aria-label="Tipo">
              <label>
                <%= radio_button_tag "items[#{index}][kind]", "troca", sent["kind"] != "devolucao", id: "item_#{index}_troca" %>
                <span><%= icon "swap_horiz" %> Troca</span>
              </label>
              <% if @eligibility == :return_and_exchange %>
                <label>
                  <%= radio_button_tag "items[#{index}][kind]", "devolucao", sent["kind"] == "devolucao", id: "item_#{index}_devolucao" %>
                  <span><%= icon "undo" %> Devolução</span>
                </label>
              <% end %>
            </div>

            <div class="field-row">
              <div class="text-field text-field--select">
                <%= select_tag "items[#{index}][reason]",
                               options_for_select(ExchangeRequestItem::REASONS.map(&:reverse), sent["reason"]),
                               include_blank: true, id: "item_#{index}_reason",
                               data: { pick_item_target: "reason", action: "pick-item#reasonChanged" } %>
                <label for="item_<%= index %>_reason">Motivo</label>
              </div>
              <% if item[:quantity] > 1 %>
                <div class="text-field text-field--narrow">
                  <%= number_field_tag "items[#{index}][quantity]", sent["quantity"] || item[:quantity], min: 1, max: item[:quantity],
                                       placeholder: " ", id: "item_#{index}_quantity" %>
                  <label for="item_<%= index %>_quantity">Quantidade</label>
                </div>
              <% end %>
            </div>

            <div class="photo-drop" data-pick-item-target="photo" hidden>
              <label class="btn btn--outlined btn--small">
                <%= icon "photo_camera" %> <span data-pick-item-target="photoLabel">Enviar foto do defeito</span>
                <%= file_field_tag "items[#{index}][photo]", accept: "image/*", class: "visually-hidden",
                                   data: { pick_item_target: "photoInput", action: "pick-item#photoChosen" } %>
              </label>
              <span class="body-small muted">Obrigatória para defeito ou avaria.</span>
            </div>
          </div>
        </fieldset>
      <% end %>

      <div class="text-field">
        <%= text_field_tag :customer_name, @customer_name, placeholder: " ", autocomplete: "name", required: true %>
        <label for="customer_name">Seu nome</label>
      </div>

      <%= button_tag type: "submit", class: "btn btn--filled btn--accent btn--block", data: { turbo_submits_with: "Enviando…" } do %>
        <%= icon "send" %> Enviar solicitação
      <% end %>
    <% end %>
  <% end %>
</div>
